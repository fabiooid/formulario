# Formulator agent. Gemini is the default when both keys exist.
# Flip with FORMULATOR_PROVIDER=openai or gemini.
# Get a Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional. Default is google/gemini-3.6-flash
GEMINI_MODEL=google/gemini-3.6-flash

# OpenAI — used when FORMULATOR_PROVIDER=openai (or when no Gemini key is set).
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Default is openai/gpt-4o-mini. Full formula drafting is much more reliable on a
# stronger model, e.g. openai/gpt-4.1 — the small model reaches the gate but rarely repairs a draft.
OPENAI_MODEL=openai/gpt-4o-mini
FORMULATOR_PROVIDER=gemini
# When both keys are set the other provider is the fallback. Retries per call on rate limits (default 4).
FORMULATOR_MAX_RETRIES=4

MASTRA_JWT_SECRET=supersecretdevkeythatishs256safe!
DATABASE_URL=file:./data/app.db
PORT=4111
