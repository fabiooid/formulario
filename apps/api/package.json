{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-strip-types --no-network-family-autoselection' node --env-file=../../.env ../../node_modules/.bin/mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "rules:refresh": "tsx --env-file-if-exists=../../.env src/db/refresh-official-lists.ts",
    "eval:briefs": "tsx --env-file=../../.env scripts/eval-briefs.ts"
  },
  "dependencies": {
    "@formulario/domain": "*",
    "@hono/node-server": "^1.14.1",
    "@libsql/client": "^0.15.4",
    "@mastra/auth": "^1.0.0",
    "@mastra/core": "1.65.0",
    "@mastra/duckdb": "^1.7.0",
    "@mastra/editor": "^0.14.4",
    "@mastra/evals": "^1.10.0",
    "@mastra/libsql": "^1.0.0",
    "@mastra/mcp": "^1.17.3",
    "@mastra/memory": "^1.0.0",
    "@mastra/observability": "^1.17.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.10",
    "jose": "^6.0.11",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "latest",
    "drizzle-kit": "^0.31.1",
    "mastra": "1.27.2",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  }
}
