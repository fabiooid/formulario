{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-strip-types --no-network-family-autoselection' node --env-file=../../.env ../../node_modules/.bin/mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:official": "tsx src/db/seed.ts --official-only",
    "users:create": "tsx --env-file-if-exists=../../.env src/db/create-user.ts",
    "scores:report": "tsx src/db/scores-report.ts",
    "feedback:report": "tsx src/db/feedback-report.ts",
    "rules:refresh": "tsx --env-file-if-exists=../../.env src/db/refresh-official-lists.ts"
  },
  "dependencies": {
    "@formulario/domain": "*",
    "@hono/node-server": "^1.14.1",
    "@libsql/client": "^0.18.0",
    "@mastra/auth": "1.1.3",
    "@mastra/core": "1.74.0",
    "@mastra/duckdb": "1.12.1",
    "@mastra/editor": "0.15.6",
    "@mastra/evals": "1.10.5",
    "@mastra/libsql": "1.25.0",
    "@mastra/mcp": "1.17.3",
    "@mastra/memory": "1.35.0",
    "@mastra/observability": "1.18.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "latest",
    "drizzle-kit": "^0.31.11",
    "mastra": "1.32.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
